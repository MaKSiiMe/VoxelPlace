POSTGRES_PASSWORD=changeme
# 16 caractères minimum, « changeme » refusé au démarrage : openssl rand -base64 24
ADMIN_PASSWORD=
JWT_SECRET=change_this_to_a_random_secret
NEXT_PUBLIC_API_URL=http://localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Secret partagé avec le plugin Minecraft — même valeur que bridge-token dans
# le config.yml du plugin. Générer avec : openssl rand -hex 32
BRIDGE_TOKEN=change_this_to_a_random_secret
